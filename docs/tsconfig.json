{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["zudoku/client", "node"]
  },
  "include": [
    "src",
    "**/*.md",
    "**/*.mdx",
    "zudoku.config.tsx",
    "zudoku.navigation.tsx",
    "vite.config.ts"
  ]
}
