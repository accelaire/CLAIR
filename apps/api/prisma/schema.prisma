// =============================================================================
// CLAIR - Schema Prisma
// Base de données PostgreSQL pour la plateforme de transparence politique
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PARLEMENTAIRES (Députés + Sénateurs) ET GROUPES POLITIQUES
// =============================================================================

model Parlementaire {
  id              String    @id @default(uuid())
  slug            String    @unique

  // Chambre: distingue députés et sénateurs
  chambre         String    @default("assemblee") // 'assemblee' | 'senat'

  // Identité
  nom             String
  prenom          String
  sexe            String?
  dateNaissance   DateTime? @map("date_naissance")
  lieuNaissance   String?   @map("lieu_naissance")
  profession      String?
  photoUrl        String?   @map("photo_url")
  twitter         String?
  facebook        String?
  email           String?
  siteWeb         String?   @map("site_web")
  actif           Boolean   @default(true)

  // Relations
  groupeId          String?          @map("groupe_id")
  groupe            GroupePolitique? @relation(fields: [groupeId], references: [id])
  circonscriptionId String?          @map("circonscription_id")
  circonscription   Circonscription? @relation(fields: [circonscriptionId], references: [id])

  // Champs spécifiques Sénat (nullable pour députés)
  serie             String?  // Série électorale sénatoriale (1, 2, 3)
  commissionPermanente String? @map("commission_permanente")

  // Stats pré-calculées (recalculées lors de l'ingestion quotidienne)
  statsPresence       Int?      @map("stats_presence")      // % de présence aux scrutins (tous types)
  statsPresenceSolennel Int?    @map("stats_presence_solennel") // % de présence aux scrutins solennels uniquement
  statsLoyaute        Int?      @map("stats_loyaute")       // % de vote avec le groupe
  statsParticipation  Int?      @map("stats_participation") // Nombre de votes (hors absences)
  statsInterventions  Int?      @map("stats_interventions") // Nombre total d'interventions
  statsAmendements    Int?      @map("stats_amendements")   // Nombre d'amendements proposés
  statsAmendementsAdoptes Int?  @map("stats_amendements_adoptes") // Nombre d'amendements adoptés
  statsQuestions      Int?      @map("stats_questions")     // Nombre de questions posées
  statsCalculatedAt   DateTime? @map("stats_calculated_at") // Date du dernier calcul

  // Stats de CARRIÈRE : tous les mandats cumulés (les stats_* ci-dessus ne portent
  // que le mandat en cours). Deux jeux de colonnes car les classements doivent
  // pouvoir trier sur l'un OU l'autre — et un tri Prisma exige une colonne scalaire.
  // Comparer des élus entre eux suppose la même période (défaut = mandat en cours) ;
  // la carrière répond à une autre question : « qui a le plus siégé, tout compris ».
  // Voir SPEC-MULTI-LEGISLATURES.md (ticket #13).
  statsCarrierePresence     Int? @map("stats_carriere_presence")
  statsCarriereLoyaute      Int? @map("stats_carriere_loyaute")
  statsCarriereParticipation Int? @map("stats_carriere_participation")
  statsCarriereInterventions Int? @map("stats_carriere_interventions")
  statsCarriereAmendements  Int? @map("stats_carriere_amendements")

  // Enrichissement IA (fiches parlementaires enrichies)
  resumeIA          String?   @map("resume_ia")
  parcoursIA        String?   @map("parcours_ia")
  positionsClesIA   String?   @map("positions_cles_ia")
  faitsNotablesIA   String?   @map("faits_notables_ia")
  iaContentHash     String?   @map("ia_content_hash")
  iaGeneratedAt     DateTime? @map("ia_generated_at")
  iaSources         Json?     @map("ia_sources") // provenance des sources web {wikipedia, wikidata: {url, fetchedAt}}

  // Relations
  votes         Vote[]
  interventions Intervention[]
  amendements          Amendement[]
  amendementsCoSignes  Amendement[] @relation("AmendementCosignataires")
  actionsLobby  ActionLobby[]
  mandats       Mandat[]
  mandatsParlementaires MandatParlementaire[]
  declarations  DeclarationHATVP[]
  reunionParticipants ReunionParticipant[]

  // Métadonnées source
  sourceId   String? @map("source_id") // PA123456 (AN) ou 14133K (Sénat)
  sourceData Json?   @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([chambre])
  @@index([groupeId])
  @@index([actif])
  @@index([nom, prenom])
  @@index([chambre, actif])
  @@map("parlementaires")
}

model GroupePolitique {
  id   String @id @default(uuid())
  slug String

  // `nom` porte le SIGLE tel que la source le code, et sert de clé de matching :
  // `GROUP_ALIASES` et `buildGroupMatcher` (checks/ia-quality.ts) sont indexés
  // dessus. Le Sénat gèle ses codes à travers les renommages pour que les données
  // historiques continuent de se rattacher — d'où « UMP » pour Les Républicains
  // et « LREM » pour le RDPI. Ne jamais y mettre un libellé lisible.
  nom String

  // Libellé court d'usage, à afficher. Vient de `libelleCourt` côté Sénat ; null
  // pour l'AN, dont le sigle de `nom` est déjà celui d'usage.
  nomCourt String? @map("nom_court")

  nomComplet String? @map("nom_complet")
  couleur    String?
  logoUrl    String? @map("logo_url")
  position   String? // 'extreme_gauche', 'gauche', 'centre_gauche', 'centre', 'centre_droit', 'droite', 'extreme_droite'
  ordre      Int     @default(0)
  actif      Boolean @default(true)

  // Chambre (les groupes AN et Sénat sont distincts)
  chambre    String  @default("assemblee") // 'assemblee' | 'senat'

  // Législature AN (15,16,17). Null pour le Sénat (groupes continus, dédup applicative par sourceId).
  legislature Int?

  // Stats pré-calculées (recalculées lors de l'ingestion quotidienne)
  statsMembresActifs           Int?      @map("stats_membres_actifs")            // Nombre de membres actifs
  statsPresenceMoyenne         Int?      @map("stats_presence_moyenne")          // % moyen de présence aux scrutins
  statsPresenceSolennelMoyenne Int?      @map("stats_presence_solennel_moyenne") // % moyen de présence aux scrutins solennels
  statsLoyauteMoyenne          Int?      @map("stats_loyaute_moyenne")           // % moyen de loyauté (cohésion)
  statsCohesion                Int?      @map("stats_cohesion")                  // % de cohésion sur TOUS les scrutins
  statsParticipation           Int?      @map("stats_participation")             // Nombre total de votes exprimés
  statsCalculatedAt            DateTime? @map("stats_calculated_at")             // Date du dernier calcul

  // Agrégation des votes (pré-calculées pour le camembert)
  statsVotesPour        Int?      @map("stats_votes_pour")       // Total des votes Pour
  statsVotesContre      Int?      @map("stats_votes_contre")     // Total des votes Contre
  statsVotesAbstention  Int?      @map("stats_votes_abstention") // Total des votes Abstention
  statsVotesAbsent      Int?      @map("stats_votes_absent")     // Total des absences

  parlementaires Parlementaire[]
  mandatsParlementaires MandatParlementaire[]
  alliancesFrom  GroupeAlliance[] @relation("GroupeFrom")
  alliancesTo    GroupeAlliance[] @relation("GroupeTo")
  statsThematiques GroupeThematique[]

  sourceId  String?  @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([slug, chambre, legislature])
  @@index([chambre])
  @@index([legislature])
  @@map("groupes_politiques")
}

// =============================================================================
// MANDATS PARLEMENTAIRES (le siège lui-même : une personne sur une période)
// Sépare l'identité (Parlementaire = personne stable) du contexte de mandat
// (groupe / circo / série / stats), pour supporter le multi-législatures AN et
// le multi-mandatures Sénat. DISTINCT du modèle `Mandat` ci-dessous (organes).
// =============================================================================

model MandatParlementaire {
  id     String @id @default(uuid())

  // Personne titulaire (identité stable, table `parlementaires`)
  personneId String        @map("personne_id")
  personne   Parlementaire @relation(fields: [personneId], references: [id], onDelete: Cascade)

  // Chambre du mandat (une personne peut cumuler AN puis Sénat sur des mandats distincts)
  chambre String @default("assemblee") // 'assemblee' | 'senat'

  // Périodisation (selon la chambre) :
  legislature Int?    // AN : 15,16,17 — null pour le Sénat
  mandature   Int?    // Sénat : année du renouvellement (2017/2020/2023/2026) — null pour l'AN
  serie       String? // Sénat : série électorale (1,2,3)

  dateDebut DateTime  @map("date_debut")
  dateFin   DateTime? @map("date_fin") // null = mandat en cours

  // Contexte de la période
  groupeId          String?          @map("groupe_id")
  groupe            GroupePolitique? @relation(fields: [groupeId], references: [id])
  circonscriptionId String?          @map("circonscription_id")
  circonscription   Circonscription? @relation(fields: [circonscriptionId], references: [id])
  commissionPermanente String?       @map("commission_permanente")

  // Stats PAR MANDAT (copiées depuis Parlementaire en Phase 0 ; recalculées en Phase 4)
  statsPresence           Int?      @map("stats_presence")
  statsPresenceSolennel   Int?      @map("stats_presence_solennel")
  statsLoyaute            Int?      @map("stats_loyaute")
  statsParticipation      Int?      @map("stats_participation")
  statsInterventions      Int?      @map("stats_interventions")
  statsAmendements        Int?      @map("stats_amendements")
  statsAmendementsAdoptes Int?      @map("stats_amendements_adoptes")
  statsQuestions          Int?      @map("stats_questions")
  statsCalculatedAt       DateTime? @map("stats_calculated_at")

  // Dédoublonnage source (ref organe-mandature AN / id mandat Sénat si dispo)
  mandatUid  String? @unique @map("mandat_uid")
  sourceData Json?   @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Garde best-effort : AN distinct par législature, Sénat par mandature.
  // (Postgres NULLS DISTINCT → dédup réel assuré par `mandatUid` + upsert Phase 1.)
  @@unique([personneId, chambre, legislature, mandature])
  @@index([personneId])
  @@index([legislature])
  @@index([mandature])
  @@index([chambre, legislature])
  @@index([groupeId])
  @@map("mandats_parlementaires")
}

// =============================================================================
// MANDATS (extraits du sourceData AN / Sénat)
// Historique des fonctions et responsabilités des parlementaires
// =============================================================================

model Mandat {
  id     String @id @default(uuid())

  parlementaireId String        @map("parlementaire_id")
  parlementaire   Parlementaire @relation(fields: [parlementaireId], references: [id], onDelete: Cascade)

  // Type de mandat/organe (AN: COMPER, DELEG, ORGEXTPARL, CMP, GOUVERNEMENT... Sénat: COMMISSION, DELEGATION/OFFICE, ETUDE...)
  typeOrgane   String  @map("type_organe")
  institution  String? // Libellé de l'organe (ex: "Commission des finances", "Office parlementaire...")
  qualite      String? // "Membre", "Président", "Vice-Président", "Rapporteur"...

  dateDebut DateTime  @map("date_debut")
  dateFin   DateTime? @map("date_fin")

  // Relation vers la commission (si le mandat est lié à une commission)
  commissionId String? @map("commission_id")
  commission   Commission? @relation(fields: [commissionId], references: [id])

  // Identifiants source (pour dédoublonnage)
  sourceUid String? @unique @map("source_uid") // PM847462 (AN) ou code organe (Sénat)

  // UID de l'organe de référence (POxxx pour les commissions AN)
  // Permet le lien direct commission ↔ mandat sans passer par le nom
  organeRef String? @map("organe_ref")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parlementaireId])
  @@index([parlementaireId, organeRef, dateFin])
  @@index([typeOrgane])
  @@index([dateDebut])
  @@index([commissionId])
  @@map("mandats")
}

// =============================================================================
// COMMISSIONS PARLEMENTAIRES
// =============================================================================

model Commission {
  id          String    @id @default(uuid())
  uid         String    @unique              // AN organe UID (ex: PO59048)
  organeRef   String?   @map("organe_ref")  // Raw organeRef (PO59048 for AN, COM-AFCL for Senate)
  slug        String    @unique              // "finances", "affaires-etrangeres"
  chambre     String                         // 'assemblee' | 'senat'
  // Types d'organes valides (String, pas d'enum SQL — validation côté code) :
  // - 'permanente'              — commissions permanentes (COMPER, COMSENAT)
  // - 'enquete'                 — commissions d'enquête (CNPE)
  // - 'speciale'                — commissions spéciales (CNPS, COMSPSENAT)
  // - 'mixte_paritaire'         — commissions mixtes paritaires (CMP)
  // - 'office'                  — offices parlementaires (OFFPAR, ex: OPECST)
  // - 'delegation'              — délégations (DELEG, DELEGBUREAU, DELEGSENAT)
  // - 'mission_info'            — missions d'information (MISINFO, MISINFOCOM, MISINFOPRE)
  // - 'groupe_etudes'           — groupes d'études (GE, GEVI)
  // - 'groupe_amitie'           — groupes d'amitié (GA)
  // - 'assemblee_internationale' — assemblées parlementaires internationales (API)
  // - 'hemicycle'               — organe racine pour séances publiques (ASSEMBLEE, SENAT)
  // - 'autre'                   — fallback (COMNL, BUREAU, CONFPT, GROUPESENAT)
  type        String                         // voir liste ci-dessus
  nom         String                         // Libellé complet
  nomCourt    String?   @map("nom_court")    // Libellé abrégé
  dateDebut   DateTime  @map("date_debut")
  dateFin     DateTime? @map("date_fin")
  actif       Boolean   @default(true)

  // Relations
  mandats     Mandat[]
  reunions    Reunion[]
  dossierCommissions  DossierCommission[]

  @@index([chambre])
  @@index([type])
  @@index([actif])
  @@index([organeRef])
  @@map("commissions")
}

// =============================================================================
// RÉUNIONS ET AGENDA PARLEMENTAIRE
// =============================================================================

model Reunion {
  id              String    @id @default(uuid())
  uid             String    @unique              // AN reunion UID
  type            String                         // 'commission', 'seance', 'initiative_parlementaire'
  dateDebut       DateTime  @map("date_debut")
  dateFin         DateTime? @map("date_fin")
  lieu            String?
  etat            String                         // 'confirme', 'annule', 'supprime', 'eventuel'
  odjResume       String?   @map("odj_resume")   // Ordre du jour (texte)
  odjComplet      String?   @map("odj_complet")  // ODJ détaillé
  captationVideo  Boolean   @default(false) @map("captation_video")
  ouvertePresse   Boolean   @default(false) @map("ouverte_presse")
  compteRenduRef  String?   @map("compte_rendu_ref") // Référence vers le CR
  urlVideo        String?   @map("url_video")         // URL vidéo directe (Sénat: videos.senat.fr)

  // Relations
  commissionId    String?   @map("commission_id")
  commission      Commission? @relation(fields: [commissionId], references: [id])

  // Référence organe brute (même si non résolue vers une Commission)
  organeRef       String?   @map("organe_ref")

  participants    ReunionParticipant[]

  @@index([dateDebut])
  @@index([commissionId])
  @@index([type])
  @@index([etat])
  @@index([organeRef])
  @@map("reunions")
}

model ReunionParticipant {
  id              String @id @default(uuid())
  reunionId       String @map("reunion_id")
  parlementaireId String @map("parlementaire_id")
  presence        String // 'present', 'absent', 'excuse'

  reunion         Reunion       @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  parlementaire   Parlementaire @relation(fields: [parlementaireId], references: [id], onDelete: Cascade)

  @@unique([reunionId, parlementaireId])
  @@index([parlementaireId])
  @@map("reunion_participants")
}

// =============================================================================
// ÉVÉNEMENTS INSTITUTIONNELS (agenda)
//
// Repères du calendrier politique qui n'ont pas de source open data : élections,
// bornes de session, suspensions de travaux, échéances budgétaires, temps forts.
// Contrairement à `Reunion` (ingérée depuis l'AN et le Sénat), le contenu est
// curé à la main dans `services/ingestion/src/workers/evenements.ts` et poussé
// par un upsert idempotent sur le `slug`.
//
// Distinction importante : un événement peut couvrir une PÉRIODE (`dateFin`
// renseignée, ex. une suspension de travaux) là où une réunion est ponctuelle.
// =============================================================================

model EvenementInstitutionnel {
  id   String @id @default(uuid())
  slug String @unique // 'senatoriales-2026', 'suspension-hiver-2027'…

  // 'election' | 'session' | 'suspension' | 'budget' | 'institution'
  type String

  titre       String
  description String? @db.Text

  dateDebut DateTime  @map("date_debut")
  dateFin   DateTime? @map("date_fin") // null = événement ponctuel

  // false = échéance connue mais date non encore fixée (décret de convocation à
  // paraître). `dateDebut` vaut alors le 1er du mois attendu, uniquement pour le
  // tri : l'UI doit afficher le mois, jamais le jour. Ne JAMAIS présenter une
  // date non décrétée comme certaine.
  datePrecise Boolean @default(true) @map("date_precise")

  // null = concerne les deux chambres (ou aucune en particulier)
  chambre String?

  // Sources officielles, tableau JSON `[{ label, url? }]`.
  //
  // Un tableau et non un couple url/source : un repère transverse s'appuie
  // légitimement sur plusieurs autorités. La suspension de séance, par exemple,
  // vaut pour les deux chambres et chacune publie la sienne — n'en citer qu'une
  // reviendrait à généraliser depuis une source unique.
  sources Json?

  // Mis en avant dans le bloc « Prochaines échéances »
  important Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dateDebut])
  @@index([type])
  @@index([important])
  @@map("evenements_institutionnels")
}

// =============================================================================
// DÉCLARATIONS HATVP (intérêts & patrimoine des parlementaires)
// Source: https://www.hatvp.fr/livraison/opendata/liste.csv
// =============================================================================

model DeclarationHATVP {
  id     String @id @default(uuid())

  parlementaireId String        @map("parlementaire_id")
  parlementaire   Parlementaire @relation(fields: [parlementaireId], references: [id], onDelete: Cascade)

  // Type: di (intérêts), dia (intérêts initiale), diam (intérêts modif),
  //        dsp (patrimoine), dspm (patrimoine modif), dspfm (patrimoine fin mandat)
  typeDocument     String  @map("type_document")
  datePublication  DateTime? @map("date_publication")
  dateDepot        DateTime? @map("date_depot")

  // Liens HATVP
  urlDossier    String?  @map("url_dossier")   // /pages_nominatives/nom-prenom-XXX
  nomFichier    String?  @map("nom_fichier")    // PDF
  xmlFichier    String?  @map("xml_fichier")    // Open data XML (si disponible)

  statut        String?  // 'Livrée', 'En cours', 'Déclaration déposée - publication à venir'
  departement   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([parlementaireId, typeDocument, dateDepot])
  @@index([parlementaireId])
  @@index([typeDocument])
  @@map("declarations_hatvp")
}

// =============================================================================
// ALLIANCES ENTRE GROUPES (pré-calculées)
// Stocke le % d'accord entre chaque paire de groupes
// =============================================================================

model GroupeAlliance {
  id String @id @default(uuid())

  groupeFromId String          @map("groupe_from_id")
  groupeFrom   GroupePolitique @relation("GroupeFrom", fields: [groupeFromId], references: [id], onDelete: Cascade)

  groupeToId String          @map("groupe_to_id")
  groupeTo   GroupePolitique @relation("GroupeTo", fields: [groupeToId], references: [id], onDelete: Cascade)

  // Stats d'accord
  votesCommuns    Int   @map("votes_communs")    // Nombre de scrutins où les deux groupes ont la même position majoritaire
  votesTotaux     Int   @map("votes_totaux")     // Nombre total de scrutins communs
  tauxAccord      Int   @map("taux_accord")      // % d'accord (votesCommuns / votesTotaux * 100)

  calculatedAt DateTime @map("calculated_at")

  @@unique([groupeFromId, groupeToId])
  @@index([groupeFromId])
  @@index([groupeToId])
  @@index([tauxAccord])
  @@map("groupes_alliances")
}

// =============================================================================
// STATS PAR THÉMATIQUE (pour radar chart)
// Position moyenne d'un groupe sur chaque thème basé sur les tags des scrutins
// =============================================================================

model GroupeThematique {
  id String @id @default(uuid())

  groupeId String          @map("groupe_id")
  groupe   GroupePolitique @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  thematique String // Tag/thème: 'économie', 'social', 'sécurité', 'europe', 'environnement', etc.

  // Stats de vote sur cette thématique
  votesTotaux       Int   @map("votes_totaux")        // Nombre de scrutins sur ce thème
  votesPour         Int   @map("votes_pour")          // Nombre de fois position majoritaire = Pour
  votesContre       Int   @map("votes_contre")        // Nombre de fois position majoritaire = Contre
  votesAbstention   Int   @map("votes_abstention")    // Nombre de fois position majoritaire = Abstention
  positionMoyenne   Float @map("position_moyenne")    // Score de -100 (Contre) à +100 (Pour)
  cohesionMoyenne   Int   @map("cohesion_moyenne")    // % de cohésion sur ce thème

  calculatedAt DateTime @map("calculated_at")

  @@unique([groupeId, thematique])
  @@index([groupeId])
  @@index([thematique])
  @@map("groupes_thematiques")
}

model Circonscription {
  id          String @id @default(uuid())
  departement String
  numero      Int
  nom         String
  population  Int?

  // Type de circonscription
  type        String @default("legislative") // 'legislative' | 'senatoriale'

  parlementaires Parlementaire[]
  mandatsParlementaires MandatParlementaire[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([departement, numero, type])
  @@index([type])
  @@index([departement])
  @@map("circonscriptions")
}

// =============================================================================
// DOSSIERS LÉGISLATIFS
// =============================================================================

model DossierLegislatif {
  id           String   @id @default(uuid())
  uid          String   @unique  // Ex: DLR5L17N50168

  legislature  Int
  titre        String
  titreCourt   String?  @map("titre_court")

  // Type de procédure
  procedureCode    String?  @map("procedure_code")     // Ex: "1", "2", "5"
  procedureLibelle String?  @map("procedure_libelle")  // Ex: "Proposition de loi ordinaire"

  // URLs
  urlAN        String?  @map("url_an")      // URL sur assemblee-nationale.fr
  urlSenat     String?  @map("url_senat")   // URL sur senat.fr

  // État du dossier
  etat         String?  // 'en_cours', 'adopte', 'rejete', 'promulgue', 'caduc', 'fusionne', 'retire'
  dateDepot    DateTime? @map("date_depot")
  dateAdoption DateTime? @map("date_adoption")

  // Loi promulguée (si applicable)
  loiNumero    String?  @map("loi_numero")     // Ex: "2024-1177"
  loiTitre     String?  @map("loi_titre")
  loiDateJO    DateTime? @map("loi_date_jo")   // Date publication JO
  urlLegifrance String?  @map("url_legifrance") // URL Légifrance pour les lois promulguées

  // Sujet parlementaire (regroupement cross-chambre)
  sujetId      String?  @map("sujet_id")
  sujet        Sujet?   @relation(fields: [sujetId], references: [id])

  // Relations
  scrutins     Scrutin[]
  amendements  Amendement[]
  dossierCommissions  DossierCommission[]
  articles     TexteArticle[]

  // Contenu enrichi par IA
  resumeIA       String?   @map("resume_ia")
  iaContentHash  String?   @map("ia_content_hash")
  iaGeneratedAt  DateTime? @map("ia_generated_at")

  // Métadonnées source
  sourceData   Json?    @map("source_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([legislature])
  @@index([etat])
  @@index([dateDepot])
  @@index([sujetId])
  @@map("dossiers_legislatifs")
}

// =============================================================================
// LIEN DOSSIERS ↔ COMMISSIONS
// =============================================================================

model DossierCommission {
  id           String    @id @default(uuid())
  dossierId    String    @map("dossier_id")
  commissionId String    @map("commission_id")
  role         String    // "fond" | "avis"

  dossier      DossierLegislatif @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  commission   Commission        @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([dossierId, commissionId, role])
  @@index([commissionId])
  @@index([dossierId])
  @@map("dossier_commissions")
}

// =============================================================================
// SUJETS PARLEMENTAIRES (regroupement cross-chambre des dossiers)
// =============================================================================

model Sujet {
  id            String    @id @default(uuid())
  slug          String    @unique
  label         String
  description   String?
  category      String?

  dossierCount  Int       @default(0) @map("dossier_count")
  scrutinCount  Int       @default(0) @map("scrutin_count")

  dateDebut       DateTime? @map("date_debut")
  dateFin         DateTime? @map("date_fin")
  dateDernierVote DateTime? @map("date_dernier_vote")

  actif         Boolean   @default(true)
  featured      Boolean   @default(false)
  featuredOrder Int       @default(0) @map("featured_order")

  matchMethod   String?   @map("match_method")  // 'cross_ref' | 'loi_numero' | 'solo'
  status        String    @default("en_cours")  // 'en_cours' | 'adopte' | 'rejete' | 'promulgue' | 'caduc' | 'retire'

  // Contenu enrichi (généré par LLM)
  resume        String?   // Résumé du sujet en langage accessible
  enjeux        String?   // Enjeux et implications du texte

  iaContentHash  String?   @map("ia_content_hash")
  iaGeneratedAt  DateTime? @map("ia_generated_at")

  // Descriptions IA des amendements par groupe politique (JSON: { [groupeSlug-chambre]: string })
  groupeAmendementDescriptions Json?   @map("groupe_amendement_descriptions")
  iaGroupeAmendementHash       String? @map("ia_groupe_amendement_hash")

  // Résolution incrémentale des liens "contexte" (vie-publique + Wikipédia) :
  // hash = md5(label|status). On ne ré-interroge Tavily que si le hash change,
  // si jamais résolu, ou si sans lien depuis >30j (retry du long-tail).
  contextResolvedAt DateTime? @map("context_resolved_at")
  contextInputHash  String?   @map("context_input_hash")

  dossiers      DossierLegislatif[]
  liens         SujetLien[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([actif])
  @@index([category])
  @@index([featured, featuredOrder])
  @@map("sujets")
}

// Liens sortants attachés à un sujet, regroupés par famille.
//   - 'construction' : documents officiels (étude d'impact, rapports, avis, versions)
//   - 'contexte'     : sources neutres/libres (Wikipédia FR, vie-publique.fr)
// La famille 'presse' n'est PAS stockée ici (servie en live + cache, cf. plan).
model SujetLien {
  id              String    @id @default(uuid())
  sujetId         String    @map("sujet_id")
  famille         String    // 'construction' | 'contexte'
  titre           String
  url             String
  source          String    // 'an' | 'senat' | 'wikipedia' | 'vie-publique'
  sourceLabel     String?   @map("source_label")
  datePublication DateTime? @map("date_publication")
  provenance      String    @default("auto")  // 'auto' | 'manual'
  ordre           Int       @default(0)

  sujet           Sujet     @relation(fields: [sujetId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([sujetId, url])
  @@index([sujetId, famille, ordre])
  @@map("sujet_liens")
}

// =============================================================================
// SCRUTINS ET VOTES
// =============================================================================

model Scrutin {
  id               String   @id @default(uuid())
  numero           Int

  // Chambre où a eu lieu le scrutin
  chambre          String   @default("assemblee") // 'assemblee' | 'senat'

  // Session parlementaire (ex: "2024" pour 2024-2025, "17" pour 17e législature AN)
  session          String   @default("17")

  // Législature AN (15,16,17) pour filtrage propre. Null pour le Sénat (périodisé par `session`).
  legislature      Int?

  date             DateTime
  titre            String
  typeVote         String   @map("type_vote") // 'solennel', 'ordinaire', 'motion' — COMMENT on vote
  // Sur QUOI porte le vote, déduit de `objetLibelle` à l'ingestion :
  // 'ensemble' | 'article' | 'amendement' | 'credits' | 'motion' | 'declaration' | 'autre'.
  // Nullable : NULL = pas encore classé (scrutin antérieur à la mise en place).
  natureVote       String?  @map("nature_vote")
  sort             String // 'adopte', 'rejete'
  nombreVotants    Int      @map("nombre_votants")
  nombrePour       Int      @map("nombre_pour")
  nombreContre     Int      @map("nombre_contre")
  nombreAbstention Int      @map("nombre_abstention")

  // Classification automatique
  tags       String[] @default([])
  importance Int      @default(1) // 1-5

  // Texte de loi associé (permet de croiser AN et Sénat)
  texteId     String? @map("texte_id")
  texteNumero String? @map("texte_numero")
  texteTitre  String? @map("texte_titre")

  // Enrichissement contexte (extrait des données brutes AN/Sénat)
  objetLibelle    String? @map("objet_libelle")    // Description détaillée de l'objet voté
  demandeurTexte  String? @map("demandeur_texte")  // Qui a demandé le vote (groupe, président, etc.)
  seanceRef       String? @map("seance_ref")       // Référence de la séance (pour lier aux débats)

  // Relation vers le dossier législatif
  dossierId       String? @map("dossier_id")
  dossier         DossierLegislatif? @relation(fields: [dossierId], references: [id])

  // Relation M:N vers les amendements votés (un scrutin peut porter sur plusieurs amendements)
  amendements     Amendement[]

  votes         Vote[]
  interventions Intervention[]  // Interventions liées (explications de vote, débats)

  // Contenu enrichi par IA
  resumeIA       String?   @map("resume_ia")
  iaContentHash  String?   @map("ia_content_hash")
  iaGeneratedAt  DateTime? @map("ia_generated_at")

  // Métadonnées source
  sourceUrl  String? @map("source_url")
  sourceData Json?   @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([numero, chambre, session])
  @@index([chambre])
  @@index([session])
  @@index([legislature])
  @@index([date])
  @@index([typeVote])
  @@index([natureVote])
  @@index([tags])
  @@index([importance])
  @@index([texteId])
  @@index([dossierId])
  @@map("scrutins")
}

model Vote {
  id String @id @default(uuid())

  parlementaireId String @map("parlementaire_id")
  parlementaire   Parlementaire @relation(fields: [parlementaireId], references: [id], onDelete: Cascade)

  scrutinId String  @map("scrutin_id")
  scrutin   Scrutin @relation(fields: [scrutinId], references: [id], onDelete: Cascade)

  position      String // 'pour', 'contre', 'abstention', 'absent'
  miseAuPoint   String? @map("mise_au_point")
  parDelegation Boolean @default(false) @map("par_delegation")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([parlementaireId, scrutinId])
  @@index([parlementaireId])
  @@index([scrutinId])
  @@index([position])
  @@index([scrutinId, position]) // Optimise les counts par position sur un scrutin
  @@map("votes")
}

// =============================================================================
// INTERVENTIONS ET AMENDEMENTS
// =============================================================================

model Intervention {
  id String @id @default(uuid())

  // Parlementaire (optionnel — null pour les non-parlementaires : ministres, etc.)
  parlementaireId String? @map("parlementaire_id")
  parlementaire   Parlementaire? @relation(fields: [parlementaireId], references: [id], onDelete: Cascade)

  // Infos orateur (toujours renseignées, indispensables quand parlementaire est null)
  orateurNom     String?  @map("orateur_nom")
  orateurPrenom  String?  @map("orateur_prenom")
  orateurQualite String?  @map("orateur_qualite") // 'ministre', 'secrétaire d\'état', etc.

  // Chambre (pour cohérence, même si lié au parlementaire)
  chambre  String   @default("assemblee") // 'assemblee' | 'senat'

  seanceId String?  @map("seance_id")
  date     DateTime
  ordre    Int?     // Ordre chronologique dans la séance (1, 2, 3...)
  type     String // 'question', 'intervention', 'explication_vote'

  contenu  String
  motsCles String[] @default([]) @map("mots_cles")

  // Relation optionnelle vers un scrutin (pour les explications de vote notamment)
  scrutinId String?  @map("scrutin_id")
  scrutin   Scrutin? @relation(fields: [scrutinId], references: [id], onDelete: SetNull)

  sourceUrl String? @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([parlementaireId])
  @@index([chambre])
  @@index([date])
  @@index([type])
  @@index([scrutinId])
  @@index([seanceId])
  @@map("interventions")
}

model Amendement {
  id     String @id @default(uuid())
  uid    String @unique // Identifiant unique (AN ou Sénat), tel que publié par la source
  // Clé de déduplication. L'AN republie un amendement sous un nouvel uid quand le
  // texte passe du projet initial (B1364) au texte de la commission (BTC1364), et
  // laisse les deux fichiers dans son archive : 346 amendements de la 17e y
  // figurent en double, identiques hors uid, datePublication et chronotag.
  // La canonique retire le TC ; c'est elle qui sert de clé d'upsert.
  uidCanonique String @unique @map("uid_canonique")
  numero String
  legislature Int @default(17)

  // Chambre d'origine
  chambre String @default("assemblee") // 'assemblee' | 'senat'

  // Auteur - peut être lié à un parlementaire ou juste un libellé
  parlementaireId  String? @map("parlementaire_id")
  parlementaire    Parlementaire? @relation(fields: [parlementaireId], references: [id], onDelete: SetNull)
  auteurRef    String? @map("auteur_ref")
  groupeRef    String? @map("groupe_ref")
  auteurLibelle String? @map("auteur_libelle")

  // Texte législatif et article visé
  texteRef    String? @map("texte_ref")
  articleVise String? @map("article_vise")

  // Relation vers le dossier législatif
  dossierId   String? @map("dossier_id")
  dossier     DossierLegislatif? @relation(fields: [dossierId], references: [id])

  // Contenu
  dispositif     String?
  exposeSommaire String? @map("expose_sommaire")

  // Résultat
  sort       String?

  dateDepot DateTime?  @map("date_depot")
  dateSort  DateTime? @map("date_sort")

  // URL source de l'amendement (ex: page senat.fr)
  sourceUrl String? @map("source_url")

  // Ordre numérique extrait du numéro (pour tri naturel)
  numeroOrdre Int? @map("numero_ordre")

  // Co-signataires (M:N)
  cosignataires Parlementaire[] @relation("AmendementCosignataires")

  // Scrutins portant sur cet amendement
  scrutins  Scrutin[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parlementaireId])
  @@index([chambre])
  @@index([sort])
  @@index([dateDepot])
  @@index([legislature])
  @@index([auteurRef])
  @@index([dossierId])
  @@index([numero, chambre, texteRef])
  @@index([chambre, texteRef, numero])
  @@index([numeroOrdre])
  @@map("amendements")
}

// =============================================================================
// ARTICLES DES TEXTES LÉGISLATIFS
// =============================================================================

// Texte d'un article, tel qu'il figure dans une version d'un texte législatif.
//
// Le contenu des articles n'existait nulle part : on stockait les amendements
// mais jamais le texte qu'ils modifient. Un scrutin « l'article 15 de la PPL … »
// n'avait donc pour toute matière que son propre titre, ce qui suffisait au
// modèle pour en inventer le contenu.
//
// La clé est (texteRef, numero) : un article n'existe que dans une version
// donnée d'un texte (l'article 15 du texte de commission n'est pas celui du
// texte adopté en séance), et c'est ce couple que porte déjà Amendement.
model TexteArticle {
  id          String @id @default(uuid())

  /// Version du texte, au format de `Amendement.texteRef` (ex: PIONANR5L17BTC1364)
  texteRef    String @map("texte_ref")
  /// Clé normalisée alignée sur `Amendement.articleVise` : "PREMIER", "15", "UNIQUE", "4 BIS"
  numero      String
  /// Libellé d'origine dans le texte : "Article 1er", "Article 1er A (nouveau)"
  libelle     String
  /// Rang de l'article dans le texte, à partir de 1
  ordre       Int
  contenu     String

  chambre     String @default("assemblee")
  legislature Int

  dossierId   String?            @map("dossier_id")
  dossier     DossierLegislatif? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  sourceUrl   String?  @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([texteRef, numero])
  @@index([texteRef])
  @@index([dossierId])
  @@index([chambre, legislature])
  @@map("textes_articles")
}

// =============================================================================
// LOBBYING (HATVP)
// =============================================================================

model Lobbyiste {
  id     String  @id @default(uuid())
  siren  String? // Not unique: multiple entities can share same SIREN (regional branches, etc.)
  nom    String
  type   String // 'entreprise', 'association', 'cabinet', 'syndicat', 'organisation_pro'
  secteur String?

  adresse    String?
  codePostal String? @map("code_postal")
  ville      String?

  budgetAnnuel Float? @map("budget_annuel")
  nbLobbyistes Int?   @map("nb_lobbyistes")
  siteWeb      String? @map("site_web")

  actions  ActionLobby[]
  secteurs LobbyisteSecteur[]

  // Identifiant stable HATVP (SIREN, RNA...) — clé d'upsert
  identifiantNational String? @unique @map("identifiant_national")

  // Métadonnées source
  sourceData Json? @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([secteur])
  @@index([type])
  @@index([nom])
  @@map("lobbyistes")
}

model ActionLobby {
  id String @id @default(uuid())

  lobbyisteId String    @map("lobbyiste_id")
  lobbyiste   Lobbyiste @relation(fields: [lobbyisteId], references: [id], onDelete: Cascade)

  // Cible de l'action (peut être député OU sénateur)
  parlementaireId String? @map("parlementaire_id")
  parlementaire   Parlementaire? @relation(fields: [parlementaireId], references: [id])
  cible    String? // 'parlementaire', 'ministre', 'administration', 'autre'

  // Cible nom normalisé (lookup table)
  cibleTypeId Int?       @map("cible_type_id")
  cibleType   CibleType? @relation(fields: [cibleTypeId], references: [id])

  // Description normalisée (lookup table)
  descriptionId Int                @map("description_id")
  actionDescription ActionDescription @relation(fields: [descriptionId], references: [id])

  dateDebut   DateTime  @map("date_debut")
  dateFin     DateTime? @map("date_fin")

  budget   Float?
  resultat String? // 'succes', 'echec', 'en_cours', 'inconnu'

  // Texte de loi concerné
  texteVise     String? @map("texte_vise")
  texteViseNom  String? @map("texte_vise_nom")

  secteurs ActionSecteur[]

  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([lobbyisteId])
  @@index([parlementaireId])
  @@index([cibleTypeId])
  @@index([descriptionId])
  @@index([dateDebut])
  @@map("actions_lobby")
}

model Secteur {
  id         String   @id // slug: "agriculture-agroalimentaire"
  label      String   @unique // "Agriculture, agroalimentaire"
  lobbyistes LobbyisteSecteur[]
  actions    ActionSecteur[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("secteurs")
}

model LobbyisteSecteur {
  id          String    @id @default(uuid())
  lobbyisteId String    @map("lobbyiste_id")
  lobbyiste   Lobbyiste @relation(fields: [lobbyisteId], references: [id], onDelete: Cascade)
  secteurId   String    @map("secteur_id")
  secteur     Secteur   @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@unique([lobbyisteId, secteurId])
  @@index([lobbyisteId])
  @@index([secteurId])
  @@map("lobbyistes_secteurs")
}

model ActionSecteur {
  id        String      @id @default(uuid())
  actionId  String      @map("action_id")
  action    ActionLobby @relation(fields: [actionId], references: [id], onDelete: Cascade)
  secteurId String      @map("secteur_id")
  secteur   Secteur     @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@unique([actionId, secteurId])
  @@index([actionId])
  @@index([secteurId])
  @@map("actions_secteurs")
}

// =============================================================================
// NORMALISATION ACTIONS LOBBY (lookup tables)
// =============================================================================

model CibleType {
  id      Int           @id @default(autoincrement())
  label   String        @unique
  actions ActionLobby[]

  @@map("cible_types")
}

model ActionDescription {
  id      Int           @id @default(autoincrement())
  texte   String        @unique
  actions ActionLobby[]

  @@map("action_descriptions")
}

// =============================================================================
// PROMESSES ET FACT-CHECKING
// =============================================================================

model Promesse {
  id String @id @default(uuid())

  parlementaireId String? @map("parlementaire_id")
  partiId  String? @map("parti_id")

  texte       String
  sourceUrl   String?   @map("source_url")
  datePromesse DateTime? @map("date_promesse")
  categorie   String?

  statut String @default("non_evaluee") // 'non_evaluee', 'tenue', 'partiellement_tenue', 'non_tenue', 'en_cours'

  // Scrutins liés pour évaluation
  scrutinsLies String[] @map("scrutins_lies")

  evaluation      String?
  evaluationDate  DateTime? @map("evaluation_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parlementaireId])
  @@index([statut])
  @@map("promesses")
}



// =============================================================================
// SYNC ET LOGS
// =============================================================================

model SyncLog {
  id       String @id @default(uuid())
  source   String // 'assemblee_nationale', 'senat', 'hatvp', 'dila'
  dataType String @default("all") @map("data_type") // 'deputes', 'scrutins', 'interventions', 'amendements', 'lobbyistes', 'all'
  type     String // 'full', 'incremental'
  statut   String // 'started', 'completed', 'failed', 'skipped'

  itemsProcessed Int @default(0) @map("items_processed")
  itemsCreated   Int @default(0) @map("items_created")
  itemsUpdated   Int @default(0) @map("items_updated")
  errorCount     Int @default(0) @map("error_count")

  metadata Json?
  error    String?

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([source])
  @@index([source, dataType])
  @@index([startedAt])
  @@map("sync_logs")
}

// État des sources pour sync incrémental (ETag, Last-Modified)
model SourceState {
  id           String   @id @default(uuid())
  source       String   // 'assemblee_nationale', 'senat', 'hatvp', 'dila'
  dataType     String   @map("data_type") // 'deputes', 'scrutins', 'interventions', etc.
  resourceUrl  String   @map("resource_url") // URL de la ressource

  lastEtag     String?  @map("last_etag")
  lastModified DateTime? @map("last_modified") // Date de dernière modification de la source
  lastSyncAt   DateTime  @map("last_sync_at") // Date de dernière sync réussie
  lastCheckAt  DateTime  @map("last_check_at") // Date de dernière vérification (même si pas de changement)

  metadata     Json?    // Infos supplémentaires (nombre d'items, etc.)

  @@unique([source, dataType])
  @@index([source])
  @@map("source_states")
}

// =============================================================================
// FEEDBACK UTILISATEURS (retours anonymes, sans cookie)
// =============================================================================

model Feedback {
  id        String   @id @default(uuid())

  sentiment String?  // 'positif' | 'neutre' | 'negatif' (émoji) — nullable
  type      String   // 'bug' | 'idee' | 'autre'
  message   String?  // texte libre optionnel
  email     String?  // contact optionnel (rappel)

  page      String?  // pathname depuis lequel le retour a été envoyé
  trigger   String?  @default("passif") // 'passif' (bouton) | 'nudge' (sollicitation)
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type])
  @@map("feedbacks")
}

