# =============================================================================
# CLAIR - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# =============================================================================
# ENVIRONNEMENT
# =============================================================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# URLs
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
DATABASE_URL="postgresql://clair:clair_dev@localhost:5432/clair"

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# SOURCES DE DONNÉES EXTERNES
# =============================================================================

# Assemblée Nationale Open Data - Pas de clé nécessaire
# NB: la législature courante n'est PAS configurable ici — elle est dérivée du
# calendrier dans services/ingestion/src/workers/mandats.ts (LEGISLATURE_DEBUT/FIN).
ASSEMBLEE_NATIONALE_BASE_URL="https://data.assemblee-nationale.fr"

# HATVP - Pas d'API officielle
HATVP_BASE_URL="https://www.hatvp.fr"

# DILA (Comptes rendus des débats)
DILA_BASE_URL="https://echanges.dila.gouv.fr/OPENDATA/Debats/AN"

# Sénat - La fenêtre de sessions n'est PAS configurable : le plancher est la
# constante SENAT_SESSION_MIN (services/ingestion/src/workers/mandats.ts) et le
# plafond suit l'année courante. Scrutins et annuaire des sénateurs partagent ce
# plancher — les désynchroniser produirait des votes orphelins.

# =============================================================================
# HELLOASSO (Dons)
# =============================================================================
NEXT_PUBLIC_HELLOASSO_ORG_SLUG=""
NEXT_PUBLIC_HELLOASSO_FORM_SLUG=""

# =============================================================================
# SÉCURITÉ
# =============================================================================

# Domaines autorisés par CORS, séparés par des virgules.
# Sert UNIQUEMENT à la configuration CORS (apps/api/src/index.ts) : c'est ce qui
# permet au navigateur d'appeler l'API depuis clair.vote. Ne pas confondre avec
# une quelconque notion de confiance — un en-tête Origin se falsifie.
CORS_ORIGIN="http://localhost:3000"

# Secret partagé identifiant le trafic interne CLAIR auprès de l'API :
# frontend côté serveur (SSR, sitemap) et scheduler d'ingestion (cache homepage).
# Exempte de rate-limit, de blocage User-Agent et d'auto-ban.
#
# Doit valoir la MÊME chose sur les trois services (API, ingestion, Vercel).
# Générer avec : openssl rand -base64 32
#
# ⚠️ Ne jamais préfixer NEXT_PUBLIC_ : ce secret n'a rien à faire dans un bundle
# navigateur.
CLAIR_INTERNAL_SECRET=""

# =============================================================================
# IA (Mistral — résumés et enrichissement)
# =============================================================================
MISTRAL_API_KEY=""

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
LOG_LEVEL="debug"

# Plausible Analytics (respectueux de la vie privée, exempt de consentement RGPD)
# Créer un compte sur https://plausible.io et ajouter votre domaine
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# =============================================================================
# FEEDBACK UTILISATEURS
# =============================================================================
# Webhook Discord (optionnel) : notifie l'équipe à chaque retour reçu.
# Salon Discord → Paramètres → Intégrations → Webhooks → Copier l'URL.
# Laisser vide pour désactiver la notification (les feedbacks restent en base).
# ⚠️ Secret : ne jamais committer la vraie valeur.
FEEDBACK_DISCORD_WEBHOOK_URL=""
